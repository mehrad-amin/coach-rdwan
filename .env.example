# Production Site URL (Optional)
# Used for canonical metadataBase in layout.js, sitemap.xml, and robots.txt.
# In Cloudflare Dashboard, set this to your production domain or workers.dev URL:
# Example: https://rdwan-fitness.workers.dev or https://rdwanfitness.com
NEXT_PUBLIC_SITE_URL=https://rdwan-fitness.workers.dev

# Google Sheets Athlete Registration Integration (Server-only)
# The deployed Google Apps Script Web App execution endpoint:
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxeKBnyvfa_plBXVly2dDzDFaA2qrambB3qyKTxHslAmD2andJDZ2myCSkR6Oh5aRnk/exec

# Secret key configured in your Google Apps Script Properties/Code
# Required: Do NOT prefix with NEXT_PUBLIC_ (server-only)
GOOGLE_SCRIPT_SECRET=your_google_script_secret_here

# Google Sheets Testimonials Integration (Server-only)
# Deploy your Google Apps Script Web App for testimonials and provide the execution endpoint:
TESTIMONIALS_APPS_SCRIPT_URL=

# Secret key configured in your Testimonials Google Apps Script Properties/Code
TESTIMONIALS_API_SECRET=
